class IDProcessor extends Thread {
          private final IDCard idCard;
          public IDProcessor(IDCard card, String threadName) {
          idCard = card;
    setName(threadName);
     }
    

    @Override
    public void run() {
        try {
            System.out.println("[SYSTEM] " + getName() + "processing has started.");
            Thread.sleep(1000); 
            
            if (idCard.validateID()) {
                idCard.displayIDinfo();
            } else {
                System.out.println("===== Process Failed :( =====" + getName());
            }
            System.out.println("[SYSTEM] " + getName() + " completed.");
            System.out.println("------------------------------------------");
        } catch (InterruptedException e) {
            System.out.println("[SYSTEM] Thread interrupted.");
        }
    }
}
public class Main {
    static DataRecord<String> savedUsername = new DataRecord<>();
    static DataRecord<String> savedPassword = new DataRecord<>();
    static DataRecord<String> savedFullname = new DataRecord<>();
    static DataRecord<String> generatedRef = new DataRecord<>();
    static DataRecord<String> savedBirthday = new DataRecord<>();
    static DataRecord<String> savedAddress = new DataRecord<>();
    static DataRecord<String> savedPlacebirth = new DataRecord<>();
    static DataRecord<String> savedNationality = new DataRecord<>();
    static DataRecord<IDCard.BloodType> savedBloodtype = new DataRecord<>();

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        while (true) {
            System.out.println("+------------------------------------------+");
            System.out.println("+       WELCOME TO GOVERNMENT INSPECT      +");
            System.out.println("+------------------------------------------+");
            System.out.println("1 - Register");
            System.out.println("2 - Login");
            System.out.println("0 - Exit");
            System.out.print("Enter choice: ");

            int choice;
            try {
                choice = input.nextInt();
                input.nextLine();
            } catch (InputMismatchException e) {
                System.out.println("Invalid input!");
                input.nextLine();
                continue;
            }

            switch (choice) {
                case 1:
                    register(input);
                    break;
                case 2:
                    login(input);
                    break;
                case 0:
                    System.out.println("System Closed.");
                    input.close();
                    return;
                default:
                    System.out.println("Invalid Choice only 0-2");
            }
        }
    }

    public static void register(Scanner input) {
        System.out.println("=====[Gov.Registration]======");
        String username;
        String password;
        
        while (true) {
            System.out.print("Account Create Username: ");
            username = input.nextLine();
            String userPattern = "^[a-zA-Z0-9]{5,20}$";
            if (Pattern.matches(userPattern, username)) {
                break;
            } else {
                System.out.println("Invalid username Use 5-20 letters/numbers only.");
            }
        }

        while (true) {
            System.out.print("Create Password: ");
            password = input.nextLine();
            String passPattern = "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)[A-Za-z\\d@#$%^&+=!]{8,}$";
            if (Pattern.matches(passPattern, password)) {
                break;
            } else {
                System.out.println("Weak password! Must contain:");
                System.out.println("- 8+ characters");
                System.out.println("- Uppercase + lowercase + number");
            }
        }

        System.out.println("+------------------------------------------+");
        System.out.println("          Additional Information           +");
        System.out.println("+------------------------------------------+");
    
        System.out.print("Enter Full Name: ");
        savedFullname.setValue(input.nextLine());
        System.out.print("Enter Birthday: ");
        savedBirthday.setValue(input.nextLine());
        System.out.print("Enter Address: ");
        savedAddress.setValue(input.nextLine());
        System.out.print("Enter Place of Birth: ");
        savedPlacebirth.setValue(input.nextLine());
        System.out.print("Enter Nationality: ");
        savedNationality.setValue(input.nextLine());
        
        while (true) {
            System.out.println("Note: Capital Letter: Given A B AB O should +- ");
            System.out.print("Enter Blood Type: ");
            String bType = input.nextLine().toUpperCase();
            String bloodPattern = "^(A|B|AB|O)[+-]$";

            if (Pattern.matches(bloodPattern, bType)) {

                switch (bType) {
                    case "A+":
                        savedBloodtype.setValue(IDCard.BloodType.A_POSITIVE);
                        break;
                    case "A-":
                        savedBloodtype.setValue(IDCard.BloodType.A_NEGATIVE);
                        break;
                    case "B+":
                        savedBloodtype.setValue(IDCard.BloodType.B_POSITIVE);
                        break;
                    case "B-":
                        savedBloodtype.setValue(IDCard.BloodType.B_NEGATIVE);
                        break;
                    case "AB+":
                        savedBloodtype.setValue(IDCard.BloodType.AB_POSITIVE);
                        break;
                    case "AB-":
                        savedBloodtype.setValue(IDCard.BloodType.AB_NEGATIVE);
                        break;
                    case "O+":
                        savedBloodtype.setValue(IDCard.BloodType.O_POSITIVE);
                        break;
                    case "O-":
                        savedBloodtype.setValue(IDCard.BloodType.O_NEGATIVE);
                        break;
                }

                break;
            } else {
                System.out.println("Invalid Blood Type!");
            }
        }
        savedUsername.setValue(username);
        savedPassword.setValue(password);

        LocalDateTime date = LocalDateTime.now();
        DateTimeFormatter format = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");

        generatedRef.setValue("" + System.currentTimeMillis());

        System.out.println("Reference Number: " + generatedRef.getValue());
        System.out.println("Date Created: " + date.format(format));
        System.out.println("Account Created Successfully!");
    }

    public static void login(Scanner input) {
        if (savedUsername.getValue() == null || savedPassword.getValue() == null) {
            System.out.println("No existing account found. Please register first.");
            return;
        }

        System.out.print("Enter Username: ");
        String username = input.nextLine();
        System.out.print("Enter Password: ");
        String password = input.nextLine();

        if (!username.equals(savedUsername.getValue()) || !password.equals(savedPassword.getValue())) {
            System.out.println("Invalid Login.");
            return;
        }

        System.out.println("Login Successful!");
        selectIDCluster(input);
    }

    public static void selectIDCluster(Scanner input) {
        while (true) {
            System.out.println("===== Selection ID =====");
            System.out.println("(1) National Identification");
            System.out.println("(2) Health Identification");
            System.out.println("(3) Financial Identification");
            System.out.println("(4) Land Transportation Identification");
            System.out.println("(5) Barangay Identification");
            System.out.println("(6) Data Receipt Request");
            System.out.println("(0) Logout");
            System.out.println("============================");
            System.out.print("Enter choice: ");

            int idChoice;
            try {
                idChoice = input.nextInt();
                input.nextLine();
            } catch (InputMismatchException e) {
                System.out.println("Invalid ID selection! Numbers only.");
                input.nextLine();
                continue;
            }

            if (idChoice == 0) {
                System.out.println("Logging out...");
                break;
            }

            if (idChoice == 6) {
                processDataReceiptRequest(input);
                continue;
            }

            LocalDateTime now = LocalDateTime.now();
            DateTimeFormatter format = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
            String timeNow = now.format(format);

            IDCard idObject;
            String threadTitle;

            switch (idChoice) {
                case 1:
                    NationalID nid = new NationalID();
                    nid.Birthday = savedBirthday.getValue();
                    nid.PlaceBirth = savedPlacebirth.getValue();
                    nid.Nationality = savedNationality.getValue();
                    nid.Bloodtype = savedBloodtype.getValue();
                    idObject = nid;
                    threadTitle = "NationalID-Thread";
                    break;
                case 2:
                    HealthID hid = new HealthID();
                    hid.PlaceBirth = savedPlacebirth.getValue();
                    hid.Bloodtype = savedBloodtype.getValue();
                    idObject = hid;
                    threadTitle = "HealthID-Thread";
                    break;
                case 3:
                    FinancialID fid = new FinancialID();
                    fid.Nationality = savedNationality.getValue();
                    
                    
                    System.out.print("Enter Financial Amount (Default 1000): ");
                    try {
                        fid.amount = input.nextDouble();
                        input.nextLine();
                    } catch (Exception e) {
                        fid.amount = 500;
                        input.nextLine();
                    }
                    fid.calculateDeductions(); 
                    
                    idObject = fid;
                    threadTitle = "FinancialID-Thread";
                    break;
                case 4:
                    LandTransportationID lid = new LandTransportationID();
                    lid.PlaceBirth = savedPlacebirth.getValue();
                    lid.Nationality = savedNationality.getValue();
                    idObject = lid;
                    threadTitle = "LandTransportationID-Thread";
                    break;
                case 5:
                    BarangayID bid = new BarangayID();
                    bid.Nationality = savedNationality.getValue();
                    idObject = bid;
                    threadTitle = "BarangayID-Thread";
                    break;
                default:
                    System.out.println("Invalid Choice.");
                    continue;
            }

            idObject.username = savedUsername.getValue();
            idObject.referenceNumber = generatedRef.getValue();
            idObject.Fullname = savedFullname.getValue();
            idObject.Address = savedAddress.getValue();
            idObject.date = timeNow;

            IDProcessor processorThread = new IDProcessor(idObject, threadTitle);
            processorThread.start();
            try {
                processorThread.join(); 
            } catch (InterruptedException e) {
                System.out.println("Thread interrupted.");
            }
            Scanner pause = new Scanner(System.in);
            System.out.println("-------Press 1 to return to dashboard...");
    while (true) {
          String back = pause.nextLine();
          if (back.equals("1")) {
        break;
        
    } else {
        System.out.println("====== Press 1 only to return ====== ");
    }
}
        }
    }

    public static void printSelectedIDs(List<? extends IDCard> trackingList) {
        System.out.println("==========================================");
        System.out.println("       PROCESSING ORDERLY ID RECEIPT      ");
        System.out.println("==========================================");

        for (IDCard card : trackingList) {
            String tName = card.getClass().getSimpleName() + "====== Existing Thread Completed.====== ";
            IDProcessor thread = new IDProcessor(card, tName);
            thread.start();
            try {
                thread.join(); 
            } catch (InterruptedException e) {
                System.out.println("Receipt execution disrupted.");
            }
        }
    }

    public static void processDataReceiptRequest(Scanner input) {
        System.out.print("Do you like to print the ID? (YES/NO): ");
        String answer = input.nextLine().trim().toUpperCase();

        if (answer.equals("NO")) {
            System.out.println("Returning...");
            return; 
        } else if (!answer.equals("YES")) {
            System.out.println("Invalid response");
            return;
        }

        System.out.println("==========================================");
        System.out.println("Unit 1: National Identification");
        System.out.println("Unit 2: Health Identification");
        System.out.println("Unit 3: Financial Identification");
        System.out.println("Unit 4: Land Transportation Identification");
        System.out.println("Unit 5: Barangay Identification");
        System.out.println("==========================================");
        System.out.print("Input your numbers separated by spaces (3 1 2): ");
        
        String inputLine = input.nextLine();
        String[] parts = inputLine.trim().split("\\s+");
        
        List<IDCard> userSelectionList = new ArrayList<>();
        LocalDateTime now = LocalDateTime.now();
        DateTimeFormatter format = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
        String timeNow = now.format(format);

        for (String part : parts) {
            if (part.isEmpty()) continue;
            try {
                int selectedUnit = Integer.parseInt(part);
                IDCard idObject = null;

                switch (selectedUnit) {
                    case 1: idObject = new NationalID(); 
                            idObject.Birthday = savedBirthday.getValue();
                            idObject.PlaceBirth = savedPlacebirth.getValue();
                            idObject.Nationality = savedNationality.getValue();
                            idObject.Bloodtype = savedBloodtype.getValue();
                            break;
                    case 2: idObject = new HealthID(); 
                            idObject.PlaceBirth = savedPlacebirth.getValue();
                            idObject.Bloodtype = savedBloodtype.getValue();
                            break;
                    case 3: 
                            FinancialID fid = new FinancialID(); 
                            fid.Nationality = savedNationality.getValue();
                            System.out.print("Enter custom receipt amount: ");
                            try {
                                fid.amount = input.nextDouble();
                                input.nextLine();
                            } catch (Exception e) {
                                fid.amount = 1000;
                                input.nextLine();
                            }
                            fid.calculateDeductions();
                            idObject = fid;
                            break;
                    case 4: idObject = new LandTransportationID(); 
                            idObject.PlaceBirth = savedPlacebirth.getValue();
                            idObject.Nationality = savedNationality.getValue();
                            break;
                    case 5: idObject = new BarangayID(); 
                            idObject.Nationality = savedNationality.getValue();
                            break;
                }

                if (idObject != null) {
                    idObject.username = savedUsername.getValue();
                    idObject.referenceNumber = generatedRef.getValue();
                    idObject.Fullname = savedFullname.getValue();
                    idObject.Address = savedAddress.getValue();
                    idObject.date = timeNow;
                    userSelectionList.add(idObject);
                }
            } catch (NumberFormatException e) {
            }
        }

        if (userSelectionList.isEmpty()) {
            System.out.println("No valid units selected.");
            return;
        }

        
        Collections.sort(userSelectionList, new Comparator<IDCard>() {
            @Override
            public int compare(IDCard A1, IDCard A2) {
                return Integer.compare(A1.sortingPriority, A2.sortingPriority);
            }
        });

        printSelectedIDs(userSelectionList);
    }
}





