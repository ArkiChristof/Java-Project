class FinancialID extends IDCard {
    double amount = 500; // Base balance value
    double var1;          // Electric base deduction
    double var2;          // Hydro base deduction
    double total;         // Remainder output

    public FinancialID() { 
        sortingPriority = 3; 
        calculateDeductions();
    }

    public void calculateDeductions() {
    var1 = amount * 0.12;
    var2 = amount * 0.10;
    total = amount - var1 - var2;
    
}
    public boolean validateID() { 
        return true; 
    }

 @Override
public void displayIDinfo() {
