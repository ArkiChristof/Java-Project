class DataRecord<T> {
    private T data;

    public void setValue(T dt) {
        data = dt;
    }

    public T getValue() {
        return data;
    }
}

abstract class IDCard {
    String username;
    String referenceNumber;
    String date;
    String Fullname;
    String Address;
    BloodType Bloodtype;
         enum BloodType {
    A_POSITIVE,
    A_NEGATIVE,
    B_POSITIVE,
    B_NEGATIVE,
    AB_POSITIVE,
    AB_NEGATIVE,
    O_POSITIVE,
    O_NEGATIVE
}

    String PlaceBirth;
    String Birthday;
    String Nationality;
    int sortingPriority; 

    abstract boolean validateID();
    abstract void displayIDinfo();
}

class NationalID extends IDCard {
    public NationalID() {
    sortingPriority = 1;}
    public boolean validateID() { return true; }
    public void displayIDinfo() {
        System.out.println("===== NATIONAL ID =====");
        System.out.println("Username: " + username);
        System.out.println("Reference Number: " + referenceNumber);
        System.out.println("Date: " + date);
        System.out.println("------------Other Information------------");
        System.out.println("Full Name: " + Fullname);
        System.out.println("Birthday: " + Birthday);
        System.out.println("Place of Birth: " + PlaceBirth);
        System.out.println("Nationality: " + Nationality);
        System.out.println("Blood Type: " + (Bloodtype != null ? Bloodtype.toString() : " "));
        System.out.println("Address: " + Address);
    }
}

